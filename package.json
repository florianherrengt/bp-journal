{
  "name": "bp-tracker",
  "description": "Self-hosted blood pressure tracker with local photo OCR and CSV storage.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florianherrengt/bp-journal.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/api/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && vite build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "exifreader": "4.53.0",
    "hono": "4.13.16",
    "moment": "2.31.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.0",
    "typescript": "~6.0.0",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
