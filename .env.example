# Choose a shared password. There is no default password.
APP_PASSWORD=replace-with-a-private-password

# Must match the address in your browser, including https:// for public hosting.
# During web development use http://localhost:5173 instead.
APP_URL=http://localhost:3000

# Optional: a random secret of at least 32 characters keeps logins across restarts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# The CSV files are the only permanent reading store. Back up this directory.
DATA_DIR=./data

# Optional server settings.
HOST=127.0.0.1
PORT=3000
# MAX_UPLOAD_BYTES=8388608
